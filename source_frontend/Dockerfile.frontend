FROM python:3.11-slim

# Set working directory;
WORKDIR /app

# Copy requirements from parent directory and install dependencies;
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy shared modules from root level;
COPY db_handler.py .
COPY util.py .

# Copy frontend module;
COPY source_frontend/ ./source_frontend/

# Create data directory for database;
RUN mkdir -p /app/data

# Set Python path;
ENV PYTHONPATH=/app

# Expose Streamlit default port;
EXPOSE 8501

# Run Streamlit dashboard;
CMD ["streamlit", "run", "source_frontend/dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]

