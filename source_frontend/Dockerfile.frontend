FROM python:3.11-slim

# Set working directory;
WORKDIR /app

# Install system dependencies if needed;
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching;
COPY requirements.txt .

# Install Python dependencies;
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy shared modules from root level;
COPY db_handler.py .
COPY util.py .

# Copy frontend module;
COPY source_frontend/ ./source_frontend/

# Create data directory for database;
RUN mkdir -p /app/data /app/models && \
    chmod 755 /app/data /app/models

# Set Python path;
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose Streamlit default port;
EXPOSE 8501

# Run Streamlit dashboard;
CMD ["streamlit", "run", "source_frontend/dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]