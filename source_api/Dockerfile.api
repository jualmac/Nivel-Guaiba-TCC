FROM python:3.11-slim

# Set working directory;
WORKDIR /app

# Install system dependencies if needed;
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching;
COPY requirements.txt .

# Install Python dependencies;
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy shared modules from root level;
COPY db_handler.py .
COPY util.py .

# Copy API module;
COPY source_api/ ./source_api/

# Copy required database module files for authentication;
COPY source_database/api_auth.py ./source_database/api_auth.py
COPY source_database/__init__.py ./source_database/__init__.py

# Create data directory for database;
RUN mkdir -p /app/data && \
    chmod 755 /app/data

# Set Python path;
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Run the API data collection script;
CMD ["python", "-u", "source_api/api_single_station.py"]