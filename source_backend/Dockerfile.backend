FROM python:3.11-slim

# Set working directory;
WORKDIR /app

# Install system dependencies if needed;
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching;
COPY requirements.txt .

# Install Python dependencies;
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy shared modules from root level;
COPY db_handler.py .
COPY util.py .

# Copy backend module;
COPY source_backend/ ./source_backend/

# Create necessary directories;
RUN mkdir -p /app/data /app/models /app/mlruns && \
    chmod 755 /app/data /app/models /app/mlruns

# Set Python path and MLflow tracking URI;
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV MLFLOW_TRACKING_URI=file:/app/mlruns

# Run the model training pipeline;
CMD ["python", "-u", "source_backend/main_backend.py"]